---
import { navegacion } from '../data/site';
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/80 backdrop-blur-md" transition:animate="none">
  <div class="container-page flex h-18 items-center justify-between gap-4">
    <Logo />

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-8 font-mono text-xs font-semibold tracking-wider uppercase">
        {navegacion.map((item) => <li><a href={item.href} class="text-ink transition hover:text-accent">{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden sm:block"><Button href="/#contacto" variante="secundario">Cotiza gratis</Button></div>
      <button
        type="button"
        id="menu-boton"
        class="inline-flex size-10 items-center justify-center rounded-[4px] border border-line text-ink hover:bg-panel lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <span data-icono="abrir"><Icon nombre="menu" /></span>
        <span data-icono="cerrar" hidden><Icon nombre="cerrar" /></span>
      </button>
    </div>
  </div>

  <nav id="menu-movil" aria-label="Principal (móvil)" class="border-t border-line bg-surface lg:hidden" hidden>
    <ul class="container-page flex flex-col py-3 font-mono text-sm font-semibold tracking-wider uppercase">
      {navegacion.map((item) => <li><a href={item.href} class="flex items-center justify-between border-b border-line px-1 py-4 hover:text-accent">{item.label}<Icon nombre="chevron" class="size-4 text-ink-soft" /></a></li>)}
      <li class="pt-4 pb-2"><Button href="/#contacto" class="w-full">Cotiza gratis</Button></li>
    </ul>
  </nav>
</header>

<script>
  // Con ClientRouter el header se reemplaza en cada navegación: se buscan los elementos cada vez.
  const elementos = () => ({ boton: document.getElementById('menu-boton'), menu: document.getElementById('menu-movil') });

  function setAbierto(abierto: boolean) {
    const { boton, menu } = elementos();
    if (!boton || !menu) return;
    menu.hidden = !abierto;
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    boton.querySelector<HTMLElement>('[data-icono="abrir"]')!.hidden = abierto;
    boton.querySelector<HTMLElement>('[data-icono="cerrar"]')!.hidden = !abierto;
  }

  document.addEventListener('astro:page-load', () => {
    const { boton, menu } = elementos();
    boton?.addEventListener('click', () => setAbierto(boton.getAttribute('aria-expanded') !== 'true'));
    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setAbierto(false);
    });
  });

  document.addEventListener('keydown', (e) => {
    const { boton } = elementos();
    if (e.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') {
      setAbierto(false);
      boton.focus();
    }
  });
</script>
