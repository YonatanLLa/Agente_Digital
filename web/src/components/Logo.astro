---
import { site } from '../data/site';
---

<a href="/" class="inline-flex items-center gap-2.5 font-extrabold tracking-tight" aria-label={`${site.nombre}, ir al inicio`}>
  <svg class="size-9" viewBox="0 0 32 32" aria-hidden="true">
    <defs>
      <linearGradient id="logo-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--color-brand)" />
        <stop offset="1" stop-color="var(--color-accent)" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#logo-grad)" />
    <path d="M9 23 16 8l7 15M11.8 17.5h8.4" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="text-lg whitespace-nowrap text-ink">{site.nombre}</span>
</a>
