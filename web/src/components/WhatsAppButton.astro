---
import { site } from '../data/site';
import { whatsappUrl } from '../lib/whatsapp';
import Icon from './ui/Icon.astro';
---

<a
  href={whatsappUrl(site.whatsapp)}
  target="_blank"
  rel="noopener"
  data-whatsapp="flotante"
  class="fixed right-4 bottom-4 z-50 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-xl shadow-black/20 transition hover:scale-105 sm:right-6 sm:bottom-6"
  aria-label="Escríbenos por WhatsApp"
>
  <Icon nombre="whatsapp" class="size-7" />
</a>

<script>
  import { track } from '../lib/analytics';

  // Un solo listener para todos los enlaces de WhatsApp de la página.
  document.addEventListener('click', (e) => {
    const enlace = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-whatsapp]');
    if (enlace) track('whatsapp_click', { ubicacion: enlace.dataset.whatsapp });
  });
</script>
