---
import type { HTMLAttributes } from 'astro/types';

type Variante = 'primario' | 'secundario' | 'whatsapp';

type Props = {
  variante?: Variante;
  tamano?: 'md' | 'lg';
  href?: string;
} & HTMLAttributes<'a'> &
  HTMLAttributes<'button'>;

const { variante = 'primario', tamano = 'md', href, class: className, ...rest } = Astro.props;

// Botones rectos con texto en monoespaciada y mayúsculas, al estilo de motion.dev.
// El primario usa el turquesa con texto negro: es el color con más contraste sobre el fondo oscuro.
const variantes: Record<Variante, string> = {
  primario: 'bg-accent text-black hover:bg-accent-strong',
  secundario: 'border border-line text-ink hover:border-ink-soft hover:bg-panel',
  whatsapp: 'bg-whatsapp text-black hover:brightness-110',
};

const tamanos = {
  md: 'px-4 py-2.5 text-xs',
  lg: 'px-6 py-4 text-sm',
};

const clases = [
  'group inline-flex items-center justify-center gap-2 rounded-[4px] font-mono font-semibold tracking-wider whitespace-nowrap uppercase transition disabled:cursor-not-allowed disabled:opacity-60',
  variantes[variante],
  tamanos[tamano],
  className,
];
---

{
  href ? (
    <a href={href} class:list={clases} {...rest}>
      <slot />
    </a>
  ) : (
    <button class:list={clases} {...rest}>
      <slot />
    </button>
  )
}
