---
interface Props {
  id: string;
  eyebrow?: string;
  titulo: string;
  intro?: string;
  fondo?: 'claro' | 'alterno';
  class?: string;
}

const { id, eyebrow, titulo, intro, fondo = 'claro', class: className } = Astro.props;
---

<!-- Bloques separados por una línea fina y encabezado alineado a la izquierda, como en motion.dev. -->
<section id={id} aria-labelledby={`${id}-titulo`} class:list={['border-t border-line py-20 sm:py-28', fondo === 'alterno' && 'bg-surface-alt', className]}>
  <div class="container-page">
    <header class="mb-12 grid gap-6 lg:mb-16 lg:grid-cols-[1.4fr_1fr] lg:items-end" data-reveal>
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id={`${id}-titulo`} class="heading-section mt-4">{titulo}</h2>
      </div>
      {intro && <p class="max-w-md text-lg text-pretty text-ink-soft lg:justify-self-end">{intro}</p>}
    </header>
    <slot />
  </div>
</section>
