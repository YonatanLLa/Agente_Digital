---
import { portafolioVisible } from '../../data/portafolio';
import { servicios } from '../../data/servicios';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';

const nombreServicio = (id: string) => servicios.find((s) => s.id === id)?.nombre ?? id;
const fondos = ['from-brand to-brand-strong', 'from-accent to-accent-strong', 'from-ink to-[#2a3157]'];
---

{
  portafolioVisible.length > 0 && (
    <Section id="portafolio" eyebrow="Portafolio" titulo="Proyectos que ya están vendiendo">
      <ul class="grid gap-6 md:grid-cols-3">
        {portafolioVisible.map((p, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 100}ms`} class="group flex flex-col overflow-hidden rounded-card border border-line bg-white transition hover:-translate-y-1 hover:shadow-xl hover:shadow-brand/10">
            <div class:list={['relative flex aspect-[16/10] items-end bg-linear-to-br p-5 text-white', fondos[i % fondos.length]]}>
              {p.ejemplo && <span class="absolute top-3 right-3 rounded-full bg-white/90 px-2 py-0.5 text-[10px] font-bold text-danger uppercase">Ejemplo · solo en desarrollo</span>}
              <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold backdrop-blur">{nombreServicio(p.servicio)}</span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-semibold text-ink-soft uppercase">{p.rubro}</p>
              <h3 class="mt-1 text-lg font-bold">{p.titulo}</h3>
              <p class="mt-2 text-sm text-ink-soft">{p.resumen}</p>
              <p class="mt-auto flex items-center gap-2 pt-5 text-sm font-semibold text-accent-strong"><Icon nombre="grafico" class="size-4" />{p.resultado}</p>
              {p.url && <a href={p.url} target="_blank" rel="noopener" class="mt-3 text-sm font-semibold text-brand hover:underline">Ver proyecto</a>}
            </div>
          </li>
        ))}
      </ul>
    </Section>
  )
}
