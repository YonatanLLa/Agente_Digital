---
import { paquetes } from '../../data/paquetes';
import { formatoSoles, servicios } from '../../data/servicios';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
---

<Section id="precios" fondo="alterno" eyebrow="Precios" titulo="Paquetes claros, sin letras pequeñas" intro="Elige el servicio y compara. Todos los precios están en soles y se pagan 50 % al inicio y 50 % a la entrega.">
  <div data-tabs>
    <div role="tablist" aria-label="Servicios" class="mb-10 flex w-fit max-w-full gap-1 overflow-x-auto rounded-[6px] border border-line bg-panel p-1">
      {
        servicios.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="shrink-0 rounded-[4px] px-4 py-2.5 font-mono text-xs font-semibold tracking-wider whitespace-nowrap text-ink-soft uppercase transition hover:text-ink aria-selected:bg-ink aria-selected:text-surface"
          >
            {s.nombre}
          </button>
        ))
      }
    </div>

    {
      servicios.map((s, i) => (
        <div role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} tabindex="0" hidden={i !== 0} class="grid gap-6 lg:grid-cols-3">
          {paquetes[s.id].map((p, j) => (
            <article data-reveal style={`--reveal-delay: ${j * 100}ms`} class:list={['relative flex flex-col rounded-card border p-7', p.destacado ? 'rayado border-brand bg-brand-soft shadow-[0_0_60px_-15px_rgb(139_108_255/0.45)] lg:-my-3 lg:py-10' : 'border-line bg-panel']}>
              {p.destacado && <p class="absolute -top-3 left-7 rounded-[4px] bg-accent px-2.5 py-1 font-mono text-[10px] font-bold tracking-wider text-black uppercase">Más elegido</p>}
              <h3 class="text-xl font-bold">{p.nombre}</h3>
              <p class="mt-1 font-mono text-xs tracking-wider text-ink-soft uppercase">{s.nombre}</p>
              <p class="mt-5">
                {p.precio === null ? (
                  <span class="text-3xl font-extrabold">A medida</span>
                ) : (
                  <span class="text-5xl font-extrabold tracking-tighter">{formatoSoles(p.precio)}</span>
                )}
              </p>
              <p class="mt-2 flex items-center gap-1.5 font-mono text-xs tracking-wide text-ink-soft uppercase"><Icon nombre="reloj" class="size-3.5" />Entrega: {p.plazo}</p>
              <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
                {p.incluye.map((item) => <li class="flex gap-2"><Icon nombre="check" class="mt-0.5 size-4 shrink-0 text-accent" />{item}</li>)}
              </ul>
              <Button href="#contacto" variante={p.destacado ? 'primario' : 'secundario'} class="mt-8 w-full" data-elegir-servicio={s.id} data-elegir-paquete={p.nombre}>
                {p.precio === null ? 'Solicitar cotización' : `Elegir ${p.nombre}`}
              </Button>
            </article>
          ))}
        </div>
      ))
    }
  </div>
  <p class="mt-10 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-soft">¿Necesitas algo distinto? Armamos una propuesta a medida. <a href="#contacto" class="link-mono">Cuéntanos tu proyecto <Icon nombre="chevron" class="size-3.5" /></a></p>
</Section>

<script>
  // Pestañas accesibles: clic, flechas, Inicio y Fin (patrón WAI-ARIA Tabs).
  // Se inicializa en cada navegación del ClientRouter.
  document.addEventListener('astro:page-load', () => {
    for (const contenedor of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
      const tabs = [...contenedor.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const paneles = [...contenedor.querySelectorAll<HTMLElement>('[role="tabpanel"]')];

      const activar = (indice: number, enfocar = false) => {
        tabs.forEach((tab, i) => {
          const activo = i === indice;
          tab.setAttribute('aria-selected', String(activo));
          tab.tabIndex = activo ? 0 : -1;
          paneles[i].hidden = !activo;
        });
        if (enfocar) tabs[indice].focus();
      };

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => activar(i));
        tab.addEventListener('keydown', (e) => {
          const ultimo = tabs.length - 1;
          const teclas: Record<string, number | undefined> = { ArrowRight: i === ultimo ? 0 : i + 1, ArrowLeft: i === 0 ? ultimo : i - 1, Home: 0, End: ultimo };
          const destino = teclas[e.key];
          if (destino === undefined) return;
          e.preventDefault();
          activar(destino, true);
        });
      });
    }
  });
</script>
