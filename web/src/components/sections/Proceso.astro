---
import { proceso } from '../../data/proceso';
import Section from '../ui/Section.astro';
---

<Section id="proceso" eyebrow="Cómo trabajamos" titulo="Un proceso simple, de la idea a tu web publicada" intro="Sabes en todo momento qué estamos haciendo, cuánto cuesta y cuándo se entrega.">
  <ol class="grid gap-px overflow-hidden rounded-card border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
    {
      proceso.map((paso, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 2) * 100}ms`} class:list={['flex flex-col gap-6 bg-panel p-6 transition hover:bg-surface-alt', i === proceso.length - 1 && 'sm:col-span-2']}>
          <span class="font-mono text-sm font-semibold text-brand">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-lg font-bold">{paso.titulo}</h3>
            <p class="mt-1 text-sm text-ink-soft">{paso.descripcion}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
