---
import { site } from '../../data/site';
import { whatsappUrl } from '../../lib/whatsapp';
import EsferaParticulas from '../EsferaParticulas.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const garantias = ['Diagnóstico gratis', 'Precio cerrado en soles', 'Pagas 50 % al inicio'];
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-titulo">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(50rem_30rem_at_75%_20%,rgb(139_108_255/0.16),transparent),radial-gradient(35rem_25rem_at_0%_100%,rgb(46_230_200/0.08),transparent)]"></div>

  <div class="container-page grid items-center gap-10 pt-14 pb-20 sm:pt-20 lg:grid-cols-[1.05fr_1fr] lg:gap-6 lg:pb-28">
    <div>
      <p class="anim-entrada eyebrow">Agencia digital en {site.ciudad} para todo el Perú</p>
      <h1 id="hero-titulo" class="anim-titulo mt-6 text-5xl leading-[0.98] font-extrabold tracking-tighter text-balance sm:text-6xl lg:text-7xl">
        Tu negocio vende más con una web que <span class="bg-linear-to-r from-brand to-accent bg-clip-text text-transparent">trabaja por ti</span>
      </h1>
      <p class="anim-entrada mt-7 max-w-xl text-lg text-pretty text-ink-soft" style="--delay: 100ms">
        Diseñamos landing pages, webs corporativas, tiendas online y sistemas a medida para pymes y emprendedores. Rápidas, listas para Google y con pagos peruanos.
      </p>

      <div class="anim-entrada mt-10 flex flex-col gap-3 sm:flex-row" style="--delay: 200ms">
        <!-- Caja en monoespaciada, equivalente al "npm install" de motion.dev, pero que abre WhatsApp. -->
        <a
          href={whatsappUrl(site.whatsapp)}
          target="_blank"
          rel="noopener"
          data-whatsapp="hero"
          class="group flex items-center justify-between gap-4 rounded-[4px] border border-line bg-panel px-4 py-4 font-mono text-sm text-ink transition hover:border-ink-soft sm:min-w-64"
        >
          <span class="flex items-center gap-3"><Icon nombre="whatsapp" class="size-5 text-whatsapp" />{site.telefono}</span>
          <Icon nombre="chevron" class="size-4 text-ink-soft transition-transform group-hover:translate-x-0.5" />
        </a>
        <Button href="/#contacto" tamano="lg">
          Cotiza tu proyecto gratis
          <Icon nombre="chevron" class="size-4 transition-transform group-hover:translate-x-0.5" />
        </Button>
      </div>

      <ul class="anim-entrada mt-8 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-wide text-ink-soft uppercase" style="--delay: 300ms">
        {garantias.map((g) => <li class="flex items-center gap-1.5"><Icon nombre="check" class="size-3.5 text-accent" />{g}</li>)}
      </ul>
    </div>

    <div class="anim-mockup relative mx-auto w-full max-w-md lg:max-w-none" style="--delay: 150ms">
      <EsferaParticulas />

      <div class="anim-flotante absolute bottom-[12%] left-0 flex items-center gap-3 rounded-[6px] border border-line bg-panel/90 px-4 py-3 backdrop-blur sm:-left-4" style="--delay: 750ms" aria-hidden="true">
        <span class="flex size-9 items-center justify-center rounded-[4px] bg-accent-soft text-accent"><Icon nombre="grafico" class="size-4" /></span>
        <div>
          <p class="font-mono text-[10px] tracking-wider text-ink-soft uppercase">Nuevo lead</p>
          <p class="text-sm font-bold">Cotización recibida</p>
        </div>
      </div>
      <div class="anim-flotante absolute top-[10%] right-0 flex items-center gap-2 rounded-[6px] border border-line bg-panel/90 px-4 py-3 backdrop-blur sm:-right-2" style="--delay: 550ms" aria-hidden="true">
        <span class="flex size-8 items-center justify-center rounded-[4px] bg-whatsapp/15 text-whatsapp"><Icon nombre="whatsapp" class="size-4" /></span>
        <p class="text-sm font-bold">Pago con Yape ✓</p>
      </div>
    </div>
  </div>
</section>
