---
import { faq } from '../../data/faq';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
---

<Section id="preguntas" eyebrow="Preguntas frecuentes" titulo="Resolvemos tus dudas">
  <div class="mx-auto max-w-3xl divide-y divide-line rounded-card border border-line bg-white">
    {
      faq.map((item) => (
        <details class="group px-6 py-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
            {item.pregunta}
            <Icon nombre="flecha" class="size-5 shrink-0 rotate-90 text-brand transition group-open:-rotate-90" />
          </summary>
          <p class="mt-3 text-ink-soft">{item.respuesta}</p>
        </details>
      ))
    }
  </div>
</Section>
