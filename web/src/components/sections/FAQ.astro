---
import { faq } from '../../data/faq';
import Icon from '../ui/Icon.astro';
import Section from '../ui/Section.astro';
---

<Section id="preguntas" eyebrow="Preguntas frecuentes" titulo="Resolvemos tus dudas">
  <div class="divide-y divide-line rounded-card border border-line bg-panel" data-reveal>
    {
      faq.map((item) => (
        <details class="group px-6 py-5 [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold transition hover:text-accent">
            {item.pregunta}
            <Icon nombre="chevron" class="size-5 shrink-0 rotate-90 text-ink-soft transition group-open:-rotate-90 group-open:text-accent" />
          </summary>
          <p class="mt-3 text-ink-soft">{item.respuesta}</p>
        </details>
      ))
    }
  </div>
</Section>
