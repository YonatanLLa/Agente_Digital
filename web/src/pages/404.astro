---
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="text-7xl font-extrabold text-brand">404</p>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight">Esta página no existe</h1>
    <p class="mt-3 max-w-md text-ink-soft">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <Button href="/" class="mt-8">Ir al inicio</Button>
  </section>
</BaseLayout>
