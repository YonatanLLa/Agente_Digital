# Copia este archivo como .env y completa los valores.
# Todas son públicas: terminan dentro del HTML/JS generado, nunca pongas secretos aquí.

# URL pública del sitio (canonical, sitemap, Open Graph)
PUBLIC_SITE_URL=https://agentedigital.pe

# WhatsApp con código de país, sin + ni espacios
PUBLIC_WHATSAPP_NUMBER=51999999999

# Base de la API de leads. Vacía = mismo origen (/api), que es lo que hace nginx en producción.
PUBLIC_API_URL=

# Google Analytics 4 (opcional). Si está vacía no se carga ningún script.
PUBLIC_GA_ID=
